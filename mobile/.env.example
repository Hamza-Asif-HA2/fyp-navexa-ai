# Copy to .env and replace host IPs with your machine's LAN address (same Wi‑Fi as the device).
# Never use localhost for physical devices — use something like 192.168.1.x

EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
EXPO_PUBLIC_VOICE_AUTH_URL=http://192.168.1.100:8000
# Wake word Python service (voice-services/wake_word/server.py), default port 8765
EXPO_PUBLIC_WAKE_WORD_WS=ws://192.168.1.100:8765
EXPO_PUBLIC_VOICE_AUTH_KEY=navexa_voice_key_2024
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
