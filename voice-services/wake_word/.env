import asyncio, websockets, json

model_path = "./hey_navexa.onnx"
detection_threshold = 0.5
websocket_port = 8765
cooldown_seconds = 2
energy_threshold = 1500
buffer_duration = 1.5
groq_api_key = "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"

async def send_wav(path):
    uri = f"ws://localhost:{websocket_port}"
    async with websockets.connect(uri) as ws:
        with open(path, "rb") as f:
            data = f.read()
        await ws.send(data)
        resp = await ws.recv()
        print("Response:", json.loads(resp))

asyncio.run(send_wav("test.wav"))
