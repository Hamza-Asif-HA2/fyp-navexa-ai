# OpenWakeWord custom model (16 kHz). Place hey_navexa.onnx next to server.py or set absolute path.
MODEL_PATH=./hey_navexa.onnx
DETECTION_THRESHOLD=0.5
WEBSOCKET_PORT=8765
COOLDOWN_SECONDS=2

# Groq (Whisper) — used for server-mic buffering when no OpenWakeWord model is loaded,
# and for transcribing binary clips from the mobile app when GROQ_API_KEY is set.
GROQ_API_KEY=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

# Energy gate (used as fallback when neither OWW nor Groq handles a clip)
ENERGY_THRESHOLD=500
BUFFER_DURATION=1.5
AUTO_CALIBRATE=true
CALIBRATION_SECONDS=1.5
CALIBRATION_MULTIPLIER=3.0

